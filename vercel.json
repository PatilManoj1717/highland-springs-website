{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/rulebook.pdf",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|twitterbot|facebot).*"
        }
      ],
      "destination": "/rulebook.html"
    }
  ]
}
